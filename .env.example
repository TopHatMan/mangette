# Copy to .env next to docker-compose.yaml if you need to override defaults.
# Defaults already publish FlareSolverr on all interfaces at host port 8191.

# 0.0.0.0 = reachable from Windows on the LAN (http://192.168.1.210:8191)
FLARESOLVERR_BIND=0.0.0.0
# Port Windows uses. Container still listens on 8191 internally.
FLARESOLVERR_PORT=8191
TZ=UTC
